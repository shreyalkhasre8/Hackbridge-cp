# =====================================================================
# HackBridge Environment Configuration
# Copy this file to .env or backend/.env and update the values
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=hackbridge_jwt_secret_change_me_in_production_key_2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hackbridge_db

# Fallback mode: if MySQL server requires authentication or is unreachable,
# backend automatically operates with the loaded relational dataset seamlessly.
USE_EMBEDDED_FALLBACK=true
